    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": [
            "@playwright/test",
            "node"
        ]
    },
    "include": [
        "**/*.ts"
    ]
}